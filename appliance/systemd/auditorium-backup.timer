# auditorium-backup.timer — nightly data backup (§13.1-§13.4; contracts §5, Q3).
#
# 03:00, not the 02:30 this timer used to carry — §13.3 is explicit and the
# phase-6 plan records the 02:30 placeholder as a fault to fix (P6-T5).

[Unit]
Description=Nightly data backup

[Timer]
# 03:00 Pacific/Auckland (timers use the system timezone)
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
