# auditorium-config-apply.service — applies /data/config/system.json before the
# application starts (§4.3, §4.11): hostname, timezone, and nftables rules
# derived from the device address table. Oneshot; the admin UI re-runs it after
# writing system.json (systemctl restart auditorium-config-apply.service).
#
# Safe with no /data/config/system.json — the script applies the §3.1/§3.3
# defaults and says so in the journal.
#
# Before=NetworkManager.service: this unit writes the NetworkManager profile
# that gives the appliance its address, so NetworkManager must start after it
# and read the profile then. Unordered, the two raced, and on the CM5 this unit
# lost every boot — it wrote the profile, asked a NetworkManager that had not
# started yet to reload, and failed (24 September 2026).

[Unit]
Description=Apply appliance system configuration (hostname, timezone, firewall)
RequiresMountsFor=/data
After=local-fs.target nftables.service auditorium-first-boot.service
Before=network-online.target knxd.service auditorium-core.service nginx.service ssh.service NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/auditorium-config-apply
SyslogIdentifier=auditorium-config-apply

[Install]
WantedBy=multi-user.target
