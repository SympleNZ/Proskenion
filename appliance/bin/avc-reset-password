#!/usr/bin/env bash
# avc-reset-password — reset the admin or operator password, the hirer PIN, or
# clear rate-limit lockouts (§6.9). Recoverable only with physical or SSH access:
#
#     sudo avc-reset-password
#
# This wrapper lives on the read-only root at /usr/local/bin, NOT under
# /opt/auditorium, so it is still here after a bad update or a damaged
# application directory. The work is done by the application's own tool,
# run as the application user so the database and its -wal/-shm sidecars
# keep their ownership.

set -euo pipefail

VENV_PYTHON=/opt/auditorium/venv/bin/python
APP_USER=auditorium

if [[ ! -x "$VENV_PYTHON" ]]; then
    cat >&2 <<MSG
avc-reset-password: the application environment is missing.

  Expected: ${VENV_PYTHON}
  /opt/auditorium is a symlink to /data/app/current (§2.3). Either /data is
  not mounted, or no application version has been installed there yet, or
  the current version is damaged.

  Check:   ls -l /opt/auditorium /data/app/
           systemctl status data.mount auditorium-core.service
  If the current version is damaged, point /data/app/current at a previous
  version (§14.3) and run this again.
MSG
    exit 2
fi

if [[ "$(id -u)" != 0 ]]; then
    echo "avc-reset-password: run with sudo" >&2
    exit 2
fi

exec runuser -u "$APP_USER" -- "$VENV_PYTHON" -m proskenion.tools.reset_password "$@"
