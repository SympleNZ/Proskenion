#!/usr/sbin/nft -f
# /etc/nftables.conf — GENERATED by auditorium-config-apply from
# /data/config/system.json. Edits here are lost at the next boot (§4.3).
# Inbound per §3.3, outbound per §3.4. Default drop both ways.

flush ruleset

table inet auditorium {
    chain input {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        # Neighbour discovery only; IPv6 is otherwise unused (§3.1)
        meta nfproto ipv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
        # Ping from the VLAN — operational, not in §3.3; errors arrive via ct related
        ip saddr 10.2.30.0/24 icmp type echo-request accept
        # §3.3 web interface and health endpoint
        ip saddr 10.2.30.0/24 tcp dport { 80, 443 } accept
        # §3.3 SSH — management_address NOT SET in system.json; whole VLAN accepted until it is
        ip saddr 10.2.30.0/24 tcp dport 22 accept
        # §3.3 Art-Net inbound: ArtPollReply for health, ArtDmx from a visiting desk
        ip saddr 10.2.30.0/24 udp dport 6454 accept
        # §3.3 RTP-MIDI from the control surface (§7.6)
        ip saddr 10.2.30.100 udp dport 5004-5005 accept
        # Device address table (§3.1) — a device reaching a fixed port we
        # listen on, independent of ct state (needed because the mixer's own
        # meter port is negotiated, so no outbound packet of ours necessarily
        # precedes its meters — see cq20b-native.md's firewall notes)
        ip saddr 10.2.30.248 udp dport 51327 accept  # mixer
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;
        oif "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta nfproto ipv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
        icmp type { echo-request, destination-unreachable, time-exceeded } accept
        # DNS
        udp dport 53 accept
        tcp dport 53 accept
        # §3.4 NTP (pool addresses change; cannot be pinned)
        udp dport 123 accept
        # §3.4 Let's Encrypt ACME and the Cloudflare API for DNS-01 — anycast, cannot be
        # pinned by address; the school firewall applies the §3.4 table at the VLAN edge
        tcp dport 443 accept
        # §11.4 email alerts — network.smtp_relay not set; no rule
        # §3.4 network backup — backup_destination not set; no rule
        # Device address table (§3.1) — one rule per device port
        ip daddr 10.2.30.252 udp dport 3671 accept  # knx_gateway
        ip daddr 10.2.30.249 tcp dport 4352 accept  # projector
        ip daddr 10.2.30.248 tcp dport 51325 accept  # mixer
        ip daddr 10.2.30.248 tcp dport 51326 accept  # mixer
        ip daddr 10.2.30.248 udp dport 1-65535 accept  # mixer: every port — a single trusted device whose port can move (e.g. a firmware update)
        ip daddr 10.2.30.245 udp dport 6454 accept  # dmx_node
        ip daddr 10.2.30.245 udp dport 5568 accept  # dmx_node
        ip daddr 10.2.30.100 udp dport 5004-5005 accept  # control_surface
        # Art-Net broadcast discovery on the VLAN (§3.1)
        ip daddr 10.2.30.255 udp dport 6454 accept
        # Anything else is dropped; log a little so §3.4's months-later failures are findable
        limit rate 6/minute log prefix "auditorium out-drop: "
    }
}
