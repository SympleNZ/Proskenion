{
  // TypeScript 7 removed baseUrl; `paths` resolve relative to this file.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@playwright/test": ["./node_modules/@playwright/test"],
      "playwright-core": ["./node_modules/playwright-core"],
      "@axe-core/playwright": ["./node_modules/@axe-core/playwright"],
      "axe-core": ["./node_modules/axe-core"]
    }
  },
  "include": ["playwright.config.ts", "../tests/e2e/**/*.ts"]
}
